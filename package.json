{
  "name": "afisha",
  "version": "1.0.0",
  "private": true,
  "description": "Вёрстка сайта концертно-экскурсионных программ по макетам Figma",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:js": "eslint scripts/*.mjs eslint.config.mjs --max-warnings 0",
    "lint:css": "eslint styles.css --max-warnings 0",
    "lint:html": "html-validate index.html",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "html-validate": "10.0.0",
    "prettier": "3.9.10"
  }
}
